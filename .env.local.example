# Absolute path to the RoyOS vault the agent writes into.
# This is the ONLY thing you may need to change. The dashboard reads (never writes) here.
ROYOS_VAULT=/Users/roygutta/Documents/RoyOS

# Ollama endpoint used to detect which local model is currently loaded / running.
# Matches the OLLAMA_URL in orchestrator.js.
OLLAMA_HOST=http://localhost:11434

# How stale state.lastRun can be (seconds) before the agent loop is considered "stopped".
# orchestrator.js idles up to 20s between cycles, so give it headroom.
ROYOS_HEARTBEAT_SECONDS=45
